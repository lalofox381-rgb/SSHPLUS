#!/bin/bash
clear
INSTALL_DIR="/usr/local/lib"
SYS_DIR="/usr/lib"
TOKEN="BLACKBOSS_VPN"
AUTH_FILE="/etc/SSHPlus/.auth"
VERSION_FILE="/etc/SSHPlus/.version"
cd $HOME

fun_bar () {
comando[0]="$1"
comando[1]="$2"
(
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} -y > /dev/null 2>&1
${comando[1]} -y > /dev/null 2>&1
touch $HOME/fim
) > /dev/null 2>&1 &
tput civis
echo -ne "  \033[1;31mPROCESANDO, POR FAVOR ESPERE \033[1;37m- \033[1;31m["
while true; do
for((i=0; i<11; i++)); do
echo -ne "\033[1;32mB\033[1;37mL\033[1;32mA\033[1;37mC\033[1;31mK\033[1;37m-\033[1;32mB\033[1;37mO\033[1;32mS\033[1;37mS\033[1;31m_\033[1;37mV\033[1;32mP\033[1;37mN "
sleep 0.3s
done
[[ -e $HOME/fim ]] && rm $HOME/fim && break
echo -e "\033[1;31m]"
sleep 1s
tput cuu1
tput dl1
echo -ne "  \033[1;31mPROCESANDO, POR FAVOR ESPERE \033[1;37m- \033[1;31m["
done
echo -e "\033[1;31m]\033[1;37m -\033[1;37m OK !\033[0m"
tput cnorm
}

echo -e "\033[1;31m═════════════════════════════════\033[0m"
tput setaf 7 ; tput setab 1 ; tput bold ; printf '%40s%s%-12s\n' "   BLACKBOSS_VPN SERVER MANAGER  " ; tput sgr0
echo -e "\033[1;31m═══════════════════════════════\033[0m"
echo ""
echo -e "             \033[1;31mINSTALADOR \033[1;37m BLACKBOSS_VPN\033[0m"
echo ""
echo -e "\033[1;31m• \033[1;37mSISTEMA DE GESTION DE SERVIDORES SSH/VPN\033[0m"
echo -e "\033[1;31m  CANAL DE TELEGRAM: \033[1;37m@BLACKBOSS_VPN\033[0m"
echo ""
echo -e "\033[1;31m• \033[1;37mRECOMENDADO \033[1;31mUSE TEMA OSCURO EN SU TERMINAL PARA\033[0m"
echo -e "\033[1;31m  UNA MEJOR EXPERIENCIA VISUAL\033[0m"
echo ""
echo -e "\033[1;31m═══════════════════════════════[\033[1;37m Owner: @BLACKBOSS_VPN \033[1;31m]═══════════════════════════════\033[0m"
echo ""
echo -ne "\033[1;31mESCRIBA S Y DARLE ENTER [N/S]: \033[1;37m"; read x
[[ $x = @(n|N) ]] && exit

# ========== CONTRASEÑA SEGURIDAD — HASH CORREGIDO ==========
OWNER_HASH="1fc0ea22cb0b76ded2c146cc57eccc0993e022c6372c14d373f1bee0c11046e3"
mkdir -p /etc/SSHPlus > /dev/null 2>&1
echo "$OWNER_HASH" > "$AUTH_FILE"
chmod 600 "$AUTH_FILE"
rm -f "$AUTH_FILE_LOG" 2>/dev/null
echo -e "\033[1;32m  Contraseña de seguridad configurada!\033[0m"
sleep 1
# ===========================================================

sed -i 's/Port 22222/Port 22/g' /etc/ssh/sshd_config  > /dev/null 2>&1
service ssh restart  > /dev/null 2>&1

echo -e "\n\033[1;37mSALTANDO VERIFICACIÓN EXTERNA — TODO LISTO LOCALMENTE\033[0m"
sleep 2s

echo "/bin/menu" > /bin/h && chmod +x /bin/h > /dev/null 2>&1
rm versao* > /dev/null 2>&1
wget -q https://raw.githubusercontent.com/lalofox381-rgb/SSHPLUS/main/Install/versao > /dev/null 2>&1
cd /bin/ > /dev/null 2>&1
rm v2raymanager > /dev/null 2>&1
wget -q https://raw.githubusercontent.com/lalofox381-rgb/SSHPLUS/main/Modulos/v2raymanager > /dev/null 2>&1
wget -q https://www.dropbox.com/s/m9tnme1jjbnehnj/botteste.sh >/dev/null 2>&1
chmod 777 v2raymanager > /dev/null 2>&1
chmod 777 botteste.sh > /dev/null 2>&1

mkdir -p /etc/SSHPlus/Modulos > /dev/null 2>&1
for mod in menu criarusuario remover monitor sshmonitor mudardata alterarlimite alterarsenha \
           expcleaner infousers banner conexao addhost delhost badvpn limiter botssh \
           senharoot detalhes v2raymanager swapmemory userbackup blockt reiniciarservicos \
           speedtest slow_dns redmonitor changesshport autobackup reiniciar estadosistema \
           logsconexion velocidadusuario certssl bandwidth bulkusers expirealert sshkeys \
           security cronbackup cleanlogs speedhour serverstats dnsmanager bot menu_auth version_control; do
    wget -q -O /usr/bin/$mod https://raw.githubusercontent.com/lalofox381-rgb/SSHPLUS/main/Modulos/$mod > /dev/null 2>&1
    chmod +x /usr/bin/$mod > /dev/null 2>&1
done

mkdir $HOME/BOT >/dev/null 2>&1
cd $HOME/BOT
wget -q https://raw.githubusercontent.com/lalofox381-rgb/SSHPLUS/main/Sistema/ShellBot.sh >/dev/null 2>&1
chmod 777 ShellBot.sh > /dev/null 2>&1
cd > /dev/null 2>&1

echo -e "\n\033[1;37mVERIFICACION COMPLETADA\033[0m"
sleep 1s
echo ""

[[ -f "$HOME/usuarios.db" ]] && {
clear
echo -e "\n\033[1;31m════════════════════════════\033[0m"
echo ""
echo -e "                 \033[1;31m• \033[1;31mATENCION \033[1;31m• \033[0m"
echo ""
echo -e "\033[1;31mUna base de Datos de Usuarios \033[1;37m(usuarios.db) Fue"
echo -e "Encontrada! Desea mantenerlos preservando el limite"
echo -e "de Conexiones simultaneas de usuarios ? O Desea"
echo -e "crear una Nueva Base de Datos ?\033[0m"
echo -e "\n\033[1;37m[\033[1;31m1\033[1;37m] \033[1;31mMantener Base de Datos Actual\033[0m"
echo -e "\033[1;37m[\033[1;31m2\033[1;37m] \033[1;31mCrear una Nueva Base de Datos\033[0m"
echo -e "\n\033[1;31m═════════════════════════════\033[0m"
echo ""
tput setaf 1 ; tput bold ; read -p "Opcion ?: " -e -i 1 optiondb ; tput sgr0
} || {
awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db
}

[[ "$optiondb" = '2' ]] && awk -F : '$3 >= 500 { print $1 " 1" }' /etc/passwd | grep -v '^nobody' > $HOME/usuarios.db

clear
tput setaf 7 ; tput setab 1 ; tput bold ; printf '%35s%s%-18s\n' " INSTALANDO COMPONENTES " ; tput sgr0
echo ""
echo -e "          \033[1;31m[\033[1;31m!\033[1;37m] \033[1;37mACTUALIZANDO SISTEMA \033[1;31m[\033[1;31m!\033[1;31m]\033[0m"
echo ""
echo -e "    \033[1;31mESTE PROCESO PUEDE TOMAR ALGUNOS MINUTOS\033[0m"
echo ""

fun_attlist () {
apt-get update -y
[[ ! -d /usr/share/.plus ]] && mkdir /usr/share/.plus
echo "crz: $(date)" > /usr/share/.plus/.plus
}
fun_bar 'fun_attlist'

clear
echo ""
echo -e "          \033[1;31m[\033[1;31m!\033[1;37m] \033[1;37mINSTALANDO PAQUETES \033[1;31m[\033[1;31m!\033[1;31m]\033[0m"
echo ""
echo -e "    \033[1;31mINSTALANDO DEPENDENCIAS NECESARIAS\033[0m"
echo ""

inst_pct () {
_pacotes=("bc" "python3" "htop" "git" "screen" "nano" "unzip" "lsof" "net-tools" "dos2unix" "nload" "jq" "curl" "figlet" "python3-pip")
for _prog in ${_pacotes[@]}; do
apt install $_prog -y
done
curl -s https://packagecloud.io/install/repositories/ookla/speedtest-cli/script.deb.sh | bash
apt install speedtest -y
}
fun_bar 'inst_pct'

[[ -f "/usr/sbin/ufw" ]] && ufw allow 443/tcp ; ufw allow 80/tcp ; ufw allow 8080/tcp

clear
echo ""
echo -e "              \033[1;31m[\033[1;31m!\033[1;37m] \033[1;31mCONFIGURANDO \033[1;31m[\033[1;31m!\033[0m]"
echo ""
echo -e "      \033[1;31mAPLICANDO CONFIGURACIONES FINALES\033[0m"
echo ""

screen -dmS ws python3 /etc/SSHPlus/wsproxy.py 80
[[ $(grep -wc "wsproxy.py" /etc/autostart) = '0' ]] && {
    echo -e "netstat -tlpn | grep -w 80 > /dev/null || { screen -r -S 'ws' -X quit; screen -dmS ws python3 /etc/SSHPlus/wsproxy.py 80; }" >> /etc/autostart
}
iptables -A INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null

CURRENT_VERSION="1.0.0"
echo "$CURRENT_VERSION" > "$VERSION_FILE"

if [[ -f "/etc/SSHPlus/ShellBot.sh" ]] && [[ -f "/etc/bot/token" ]]; then
    echo -e "\033[1;32m  Bot ya configurado - reiniciando\033[0m"
    screen -dmS bot_plus /usr/bin/bot 2>/dev/null
fi

clear
cd $HOME
echo -e "        \033[1;31m • \033[1;37mINSTALACION COMPLETADA \033[1;31m• \033[0m"
echo -e "        \033[1;37mVersion: \033[1;33m${CURRENT_VERSION}\033[0m"
echo ""
echo -e "\033[1;31m COMANDO PRINCIPAL: \033[1;37mmenu\033[0m"
echo -e "\033[1;31m TELEGRAM: \033[1;37m@BLACKBOSS_VPN\033[0m"
echo -e "\033[1;31m Owner: \033[1;37m@BLACKBOSS_VPN\033[0m"
echo ""
echo -e "\033[1;37m Se requiere contraseña para acceder al panel.\033[0m"
echo -e "\033[1;37m Use \033[1;33mmenu\033[1;37m para iniciar sesión.\033[0m"
rm $HOME/Plus && cat /dev/null > ~/.bash_history && history -c
echo ""
menu
