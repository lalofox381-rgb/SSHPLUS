#!/bin/bash
clear
chk=$(cat /etc/ssh/sshd_config | grep Banner)
[[ $(netstat -nltp|grep 'dropbear' | wc -l) != '0' ]] && {
    local="/etc/bannerssh"
	[[ $(grep -wc $local /etc/default/dropbear) = '0' ]] && echo 'DROPBEAR_BANNER="/etc/bannerssh"' >>  /etc/default/dropbear
}
[[ "$(echo "$chk" | grep -v '#Banner' | grep Banner)" != "" ]] && {
	local=$(echo "$chk" |grep -v "#Banner" | grep Banner | awk '{print $2}')
} || {
    local="/etc/bannerssh"
    [[ $(grep -wc $local /etc/ssh/sshd_config) = '0' ]] && echo "Banner /etc/bannerssh" >> /etc/ssh/sshd_config
}
restart_services() {
    service ssh restart > /dev/null 2>&1
    service dropbear restart > /dev/null 2>&1
}
echo -e "\E[44;1;37m         BANNER SSH  @Netxxus           \E[0m"
echo ""
echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;37m • \033[1;33mAGREGAR BANNER (TEXTO SIMPLE)"
echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;37m • \033[1;33mAGREGAR BANNER HTML PERSONALIZADO"
echo -e "\033[1;31m[\033[1;36m3\033[1;31m]\033[1;37m • \033[1;33mVER BANNER ACTUAL"
echo -e "\033[1;31m[\033[1;36m4\033[1;31m]\033[1;37m • \033[1;33mBORRAR BANNER"
echo -e "\033[1;31m[\033[1;36m5\033[1;31m]\033[1;37m • \033[1;33mVOLVER"
echo ""
echo -ne "\033[1;32m OPCION:\033[1;37m "; read resp
if [[ "$resp" = "1" ]]; then
	echo ""
	echo -ne "\033[1;32m MENSAJE:\033[1;37m "; read msg1
	if [[ -z "$msg1" ]]; then
		echo -e "\n\033[1;31mCampo vacio!\033[0m"
		sleep 2
		banner
	fi
	echo -e "\n\033[1;31m[\033[1;36m01\033[1;31m]\033[1;33m PEQUENA"
	echo -e "\033[1;31m[\033[1;36m02\033[1;31m]\033[1;33m MEDIA"
	echo -e "\033[1;31m[\033[1;36m03\033[1;31m]\033[1;33m GRANDE"
	echo -e "\033[1;31m[\033[1;36m04\033[1;31m]\033[1;33m GIGANTE"
	echo ""
	echo -ne "\033[1;32m TAMAÑO:\033[1;37m "; read opc
	case "$opc" in
		1|01) _size='6' ;;
		2|02) _size='4' ;;
		3|03) _size='3' ;;
		4|04) _size='1' ;;
		*) _size='4' ;;
	esac
	echo -e "\n\033[1;31m[\033[1;36m01\033[1;31m]\033[1;33m AZUL"
	echo -e "\033[1;31m[\033[1;36m02\033[1;31m]\033[1;33m VERDE"
	echo -e "\033[1;31m[\033[1;36m03\033[1;31m]\033[1;33m ROJO"
	echo -e "\033[1;31m[\033[1;36m04\033[1;31m]\033[1;33m AMARILLO"
	echo -e "\033[1;31m[\033[1;36m05\033[1;31m]\033[1;33m ROSADO"
	echo -e "\033[1;31m[\033[1;36m06\033[1;31m]\033[1;33m CYAN"
	echo -e "\033[1;31m[\033[1;36m07\033[1;31m]\033[1;33m NARANJA"
	echo -e "\033[1;31m[\033[1;36m08\033[1;31m]\033[1;33m ROJO OSCURO"
	echo -e "\033[1;31m[\033[1;36m09\033[1;31m]\033[1;33m BLANCO"
	echo -e "\033[1;31m[\033[1;36m10\033[1;31m]\033[1;33m SIN COLOR"
	echo ""
	echo -ne "\033[1;32m COLOR:\033[1;37m "; read ban_cor
	case "$ban_cor" in
		1|01) _color='blue' ;;
		2|02) _color='green' ;;
		3|03) _color='red' ;;
		4|04) _color='yellow' ;;
		5|05) _color='#F535AA' ;;
		6|06) _color='cyan' ;;
		7|07) _color='#FF7F00' ;;
		8|08) _color='#9932CD' ;;
		9|09) _color='white' ;;
		10) _color='' ;;
		*) _color='red' ;;
	esac
	if [[ -n "$_color" ]]; then
		echo "<h${_size}><font color='${_color}'>${msg1}</font></h${_size}>" > $local
	else
		echo "<h${_size}>${msg1}</h${_size}>" > $local
	fi
	restart_services
	echo -e "\n\033[1;32mBANNER DEFINIDO CON EXITO!\033[0m"
	sleep 2
	banner
elif [[ "$resp" = "2" ]]; then
	clear
	echo -e "\E[44;1;37m       BANNER HTML PERSONALIZADO        \E[0m"
	echo ""
	echo -e "\033[1;33mPega tu codigo HTML personalizado abajo.\033[0m"
	echo -e "\033[1;33mPuede incluir imagenes, estilos, colores, etc.\033[0m"
	echo -e "\033[1;33mCuando termine, escriba FIN en una linea nueva.\033[0m"
	echo ""
	echo -e "\033[1;31mEjemplo de HTML valido:\033[0m"
	echo -e "\033[1;37m<div style='text-align:center;background:#000;padding:20px'>"
	echo -e "<h1 style='color:red'>MI BANNER</h1>"
	echo -e "<p style='color:white'>Bienvenido al servidor</p>"
	echo -e "</div>\033[0m"
	echo ""
	echo -e "\033[1;31m--- INICIO DEL HTML ---\033[0m"
	> /tmp/banner_tmp.txt
	while true; do
		read -r line
		if [[ "$line" == "FIN" ]]; then
			break
		fi
		echo "$line" >> /tmp/banner_tmp.txt
	done
	echo -e "\033[1;31m--- FIN DEL HTML ---\033[0m"
	echo ""
	if [[ -s /tmp/banner_tmp.txt ]]; then
		cat /tmp/banner_tmp.txt > $local
		rm -f /tmp/banner_tmp.txt
		restart_services
		echo -e "\033[1;32mBANNER HTML PERSONALIZADO INSTALADO!\033[0m"
		echo -e "\033[1;37mArchivo: $local\033[0m"
	else
		rm -f /tmp/banner_tmp.txt
		echo -e "\033[1;31mCancelado o vacio!\033[0m"
	fi
	sleep 2
	banner
elif [[ "$resp" = "3" ]]; then
	clear
	echo -e "\E[44;1;37m         BANNER ACTUAL                  \E[0m"
	echo ""
	echo -e "\033[1;33mArchivo: $local\033[0m"
	echo -e "\033[1;33mContenido:\033[0m"
	echo -e "\033[1;31m─────────────────────────────────────\033[0m"
	if [[ -f "$local" ]]; then
		cat "$local"
	else
		echo -e "\033[1;31mNo hay banner configurado\033[0m"
	fi
	echo ""
	echo -e "\033[1;31m─────────────────────────────────────\033[0m"
	echo ""
	echo -ne "\033[1;37m [ENTER] Volver"; read
	banner
elif [[ "$resp" = "4" ]]; then
	echo "" > $local
	restart_services
	echo -e "\n\033[1;32mBANNER ELIMINADO!\033[0m"
	sleep 2
	banner
elif [[ "$resp" = "5" ]]; then
	menu
else
	echo -e "\n\033[1;31mOpcion invalida!\033[0m"
	sleep 2
	banner
fi
