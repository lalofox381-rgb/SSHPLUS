#!/bin/bash
clear
rojo="\033[1;31m"
verde="\033[1;32m"
amarillo="\033[1;33m"
blanco="\033[1;37m"
cyan="\033[1;36m"
fin="\033[0m"

echo -e "${rojo}═══════════════════════════════════════${fin}"
echo -e "${blanco}  ALERTA DE EXPIRACION - @Netxxus${fin}"
echo -e "${rojo}═══════════════════════════════════════${fin}"
echo ""

echo -e "${amarillo}  DIAS DE ALERTA:${fin} (usuarios que expiran en X dias) "; read dias_alerta
dias_alerta=${dias_alerta:-7}

echo ""
echo -e "${cyan}  Usuarios que expiran en $dias_alerta dias o menos:${fin}"
echo -e "${rojo}─────────────────────────────────────────${fin}"

expirados=0
proximo=0

for user in $(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody); do
    datauser=$(LC_ALL=C chage -l "$user" 2>/dev/null | grep -i "Account expires" | head -1 | awk -F: '{print $2}' | sed 's/^ //')
    
    [[ -z "$datauser" || "$datauser" == " never" || "$datauser" == " nunca" ]] && continue
    
    hoy=$(date +%s)
    fecha_exp=$(date -d "$datauser" +%s 2>/dev/null)
    [[ -z "$fecha_exp" ]] && continue
    
    diff=$((fecha_exp - hoy))
    dias=$((diff / 86400))
    
    if [[ $dias -lt 0 ]]; then
        echo -e "  ${rojo}✗ EXPIRADO${fin}  $user  (expiro hace $((dias * -1)) dias)"
        ((expirados++))
    elif [[ $dias -le $dias_alerta ]]; then
        horas=$(( (diff % 86400) / 3600 ))
        echo -e "  ${amarillo}⚠ ALERTA${fin}    $user  (expira en ${dias}d ${horas}h)"
        ((proximo++))
    fi
done

echo ""
echo -e "${rojo}─────────────────────────────────────────${fin}"
echo -e "  ${rojo}Expirados: $expirados${fin}  ${amarillo}Proximos a expirar: $proximo${fin}"
echo -e "${rojo}─────────────────────────────────────────${fin}"
echo ""
echo -e "${blanco}  [ENTER] Volver${fin}"
read
