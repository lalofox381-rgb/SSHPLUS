#!/bin/bash
AUTH_FILE="/etc/SSHPlus/.auth"
AUTH_LOG="/etc/SSHPlus/.auth_log"
VERSION_FILE="/etc/SSHPlus/.version"
OWNER_HASH="fc9a78c35297148489ffc0a5d3c4256c4412a942f1e9da24e51ad426d1e633d3"
MAX_ATTEMPTS=3
LOCKOUT_TIME=300

rojo="\033[1;31m"
verde="\033[1;32m"
amarillo="\033[1;33m"
blanco="\033[1;37m"
fin="\033[0m"

check_lockout() {
    if [[ -f "$AUTH_LOG" ]]; then
        last_fail=$(cat "$AUTH_LOG" 2>/dev/null)
        if [[ -n "$last_fail" ]]; then
            now=$(date +%s)
            diff=$((now - last_fail))
            if [[ $diff -lt $LOCKOUT_TIME ]]; then
                remaining=$(( (LOCKOUT_TIME - diff) / 60 ))
                echo -e "${rojo}  BLOQUEADO - Intenta de nuevo en ${remaining} minutos${fin}"
                return 1
            fi
        fi
    fi
    return 0
}

log_failed() {
    date +%s > "$AUTH_LOG" 2>/dev/null
}

clear_failed() {
    rm -f "$AUTH_LOG" 2>/dev/null
}

install_owner_password() {
    echo "$OWNER_HASH" > "$AUTH_FILE"
    chmod 600 "$AUTH_FILE"
    clear_failed
}

verify_password() {
    # Auto-install owner password if no auth file
    if [[ ! -f "$AUTH_FILE" ]]; then
        install_owner_password
    fi
    
    check_lockout || return 1
    
    local current_version="0.0.0"
    [[ -f "$VERSION_FILE" ]] && current_version=$(cat "$VERSION_FILE")
    
    clear
    echo -e "${rojo}═══════════════════════════════════════${fin}"
    echo -e "${blanco}  SSHPLUS @Netxxus - v${current_version}${fin}"
    echo -e "${rojo}═══════════════════════════════════════${fin}"
    echo ""
    
    attempts=0
    while [[ $attempts -lt $MAX_ATTEMPTS ]]; do
        echo -ne "${amarillo}  Contrasena: ${fin}"; read -s input_pass
        echo ""
        
        stored_hash=$(cat "$AUTH_FILE" 2>/dev/null)
        input_hash=$(echo -n "$input_pass" | sha256sum | awk '{print $1}')
        
        if [[ "$input_hash" == "$stored_hash" ]]; then
            clear_failed
            echo -e "${verde}  Acceso concedido!${fin}"
            sleep 0.5
            return 0
        fi
        
        ((attempts++))
        remaining=$((MAX_ATTEMPTS - attempts))
        echo -e "${rojo}  Contrasena incorrecta! ($remaining intentos restantes)${fin}"
    done
    
    log_failed
    echo -e "${rojo}  DEMASIADOS INTENTOS - Bloqueado por $((LOCKOUT_TIME/60)) minutos${fin}"
    sleep 2
    return 1
}

reset_auth() {
    rm -f "$AUTH_FILE" "$AUTH_LOG" 2>/dev/null
    install_owner_password
}

get_version() {
    if [[ -f "$VERSION_FILE" ]]; then
        cat "$VERSION_FILE"
    else
        echo "0.0.0"
    fi
}
