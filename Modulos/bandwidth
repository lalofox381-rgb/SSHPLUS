#!/bin/bash
clear
rojo="\033[1;31m"
verde="\033[1;32m"
amarillo="\033[1;33m"
blanco="\033[1;37m"
fin="\033[0m"
database="/root/usuarios.db"

echo -e "${rojo}═══════════════════════════════════════${fin}"
echo -e "${blanco}  MONITOR DE ANCHO DE BANDA - @Netxxus${fin}"
echo -e "${rojo}═══════════════════════════════════════${fin}"
echo ""

echo -e "${amarillo}  INTERFAZ       RECIBIDO        ENVIADO${fin}"
echo -e "${rojo}─────────────────────────────────────────${fin}"

for iface in $(ls /sys/class/net/ 2>/dev/null | grep -v lo); do
    rx=$(cat /sys/class/net/$iface/statistics/rx_bytes 2>/dev/null || echo 0)
    tx=$(cat /sys/class/net/$iface/statistics/tx_bytes 2>/dev/null || echo 0)
    rx_gb=$(echo "scale=2; $rx/1073741824" | bc 2>/dev/null || echo "0")
    tx_gb=$(echo "scale=2; $tx/1073741824" | bc 2>/dev/null || echo "0")
    echo -e "  ${amarillo}$iface${fin}         ${blanco}${rx_gb}GB${fin}        ${blanco}${tx_gb}GB${fin}"
done

echo ""
echo -e "${rojo}─────────────────────────────────────────${fin}"
echo -e "${amarillo}  USUARIOS Y SUS CONEXIONES:${fin}"
echo -e "${rojo}─────────────────────────────────────────${fin}"

if [[ -f "$database" ]]; then
    while IFS=' ' read -r username limit; do
        [[ -z "$username" || "$username" == "#"* ]] && continue
        conns=$(ps -u "$username" 2>/dev/null | grep -c "[s]shd" || true)
        conns=$(echo "$conns" | tr -d '[:space:]')
        [[ -z "$conns" ]] && conns=0
        if [[ "$conns" -gt 0 ]] 2>/dev/null; then
            status="${verde}●${fin}"
        else
            status="${rojo}○${fin}"
        fi
        echo -e "  ${status} ${amarillo}$username${fin}  Conexiones: ${blanco}$conns/$limit${fin}"
    done < "$database"
fi

echo ""
echo -e "${rojo}─────────────────────────────────────────${fin}"
echo -e "${blanco}  [ENTER] Volver${fin}"
read
