#!/bin/bash
clear
rojo="\033[1;31m"
verde="\033[1;32m"
amarillo="\033[1;33m"
blanco="\033[1;37m"
fin="\033[0m"
BACKUP_DIR="/root/backups"
CRON_FILE="/etc/cron.d/sshplus_backup"

echo -e "${rojo}═══════════════════════════════════════${fin}"
echo -e "${blanco}  BACKUP AUTOMATICO CON CRON - @Netxxus${fin}"
echo -e "${rojo}═══════════════════════════════════════${fin}"
echo ""

# Verificar estado actual
if [[ -f "$CRON_FILE" ]]; then
    echo -e "  Estado: ${verde}ACTIVO${fin}"
    echo -e "  Horario: ${blanco}$(cat $CRON_FILE | grep -v '^#' | head -1)${fin}"
else
    echo -e "  Estado: ${rojo}INACTIVO${fin}"
fi

echo ""
echo -e "${amarillo}  [1]${fin} Activar backup diario"
echo -e "${amarillo}  [2]${fin} Activar backup semanal"
echo -e "${amarillo}  [3]${fin} Desactivar backup"
echo -e "${amarillo}  [4]${fin} Hacer backup ahora"
echo -e "${amarillo}  [5]${fin} Ver backups"
echo -e "${amarillo}  [6]${fin} Restaurar backup"
echo -e "${amarillo}  [0]${fin} Volver"
echo ""
echo -ne "${blanco}  Opcion: ${fin}"; read op

case "$op" in
    1)
        mkdir -p "$BACKUP_DIR"
        echo "# SSHPlus Daily Backup" > "$CRON_FILE"
        echo "0 3 * * * root /usr/bin/backup_cron.sh" >> "$CRON_FILE"
        chmod 644 "$CRON_FILE"
        
        # Crear script de backup
        cat > /usr/bin/backup_cron.sh << 'BEOF'
#!/bin/bash
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="/root/backups"
mkdir -p $BACKUP_DIR
tar czf $BACKUP_DIR/usuarios_$DATE.tar.gz /root/usuarios.db /etc/SSHPlus 2>/dev/null
find $BACKUP_DIR -name "*.tar.gz" -mtime +7 -delete 2>/dev/null
BEOF
        chmod 755 /usr/bin/backup_cron.sh
        echo -e "${verde}  Backup diario activado (3:00 AM)${fin}"
        ;;
    2)
        mkdir -p "$BACKUP_DIR"
        echo "# SSHPlus Weekly Backup" > "$CRON_FILE"
        echo "0 3 * * 0 root /usr/bin/backup_cron.sh" >> "$CRON_FILE"
        chmod 644 "$CRON_FILE"
        
        cat > /usr/bin/backup_cron.sh << 'BEOF'
#!/bin/bash
DATE=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="/root/backups"
mkdir -p $BACKUP_DIR
tar czf $BACKUP_DIR/usuarios_$DATE.tar.gz /root/usuarios.db /etc/SSHPlus 2>/dev/null
find $BACKUP_DIR -name "*.tar.gz" -mtime +30 -delete 2>/dev/null
BEOF
        chmod 755 /usr/bin/backup_cron.sh
        echo -e "${verde}  Backup semanal activado (Domingos 3:00 AM)${fin}"
        ;;
    3)
        rm -f "$CRON_FILE"
        echo -e "${verde}  Backup automatizado desactivado${fin}"
        ;;
    4)
        mkdir -p "$BACKUP_DIR"
        DATE=$(date +%Y%m%d_%H%M%S)
        tar czf "$BACKUP_DIR/usuarios_$DATE.tar.gz" /root/usuarios.db /etc/SSHPlus 2>/dev/null
        echo -e "${verde}  Backup creado: $BACKUP_DIR/usuarios_$DATE.tar.gz${fin}"
        ;;
    5)
        echo -e "${amarillo}  BACKUPS DISPONIBLES:${fin}"
        echo -e "${rojo}─────────────────────────────────────────${fin}"
        ls -lh "$BACKUP_DIR"/*.tar.gz 2>/dev/null | while read line; do
            echo -e "  $line"
        done
        [[ -z "$(ls $BACKUP_DIR/*.tar.gz 2>/dev/null)" ]] && echo -e "  ${amarillo}No hay backups${fin}"
        ;;
    6)
        echo -e "${amarillo}  BACKUPS DISPONIBLES:${fin}"
        ls -1 "$BACKUP_DIR"/*.tar.gz 2>/dev/null | nl
        echo ""
        echo -ne "${blanco}  Numero del backup a restaurar (0=volver): ${fin}"; read num
        [[ "$num" == "0" ]] && exit 0
        
        backup=$(ls "$BACKUP_DIR"/*.tar.gz 2>/dev/null | sed -n "${num}p")
        if [[ -n "$backup" ]]; then
            tar xzf "$backup" -C / 2>/dev/null
            echo -e "${verde}  Backup restaurado!${fin}"
        else
            echo -e "${rojo}  Backup no encontrado!${fin}"
        fi
        ;;
    0)
        exit 0
        ;;
esac

echo ""
echo -e "${blanco}  [ENTER] Volver${fin}"
read
