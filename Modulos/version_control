#!/bin/bash
VERSION_FILE="/etc/SSHPlus/.version"
GITHUB_REPO="Netxxus/SSHPLUS"
GITHUB_RAW="https://raw.githubusercontent.com/Netxxus/SSHPLUS/main"

get_current_version() {
    if [[ -f "$VERSION_FILE" ]]; then
        cat "$VERSION_FILE"
    else
        echo "0.0.0"
    fi
}

set_version() {
    echo "$1" > "$VERSION_FILE"
}

check_update_available() {
    remote_version=$(curl -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null | grep '"tag_name"' | cut -d'"' -f4)
    if [[ -z "$remote_version" ]]; then
        remote_version=$(curl -s "https://raw.githubusercontent.com/$GITHUB_REPO/main/VERSION" 2>/dev/null | head -1)
    fi
    current=$(get_current_version)
    
    if [[ "$remote_version" == "$current" ]]; then
        echo "UP_TO_DATE"
    else
        echo "$remote_version"
    fi
}

do_update() {
    echo "ACTUALIZANDO SCRIPTS..."
    
    # Download and replace all modules
    modules=(menu criarusuario remover monitor sshmonitor mudardata alterarlimite alterarsenha 
             expcleaner infousers banner conexao addhost delhost badvpn limiter botssh 
             senharoot detalhes v2raymanager swapmemory userbackup blockt reiniciarservicos 
             speedtest slow_dns redmonitor changesshport autobackup reiniciar estadosistema 
             logsconexion velocidadusuario certssl bandwidth bulkusers expirealert sshkeys 
             security cronbackup cleanlogs speedhour serverstats dnsmanager bot menu_auth)
    
    success=0
    failed=0
    
    for mod in "${modules[@]}"; do
        if wget -q "$GITHUB_RAW/Modulos/$mod" -O "/tmp/${mod}_new" 2>/dev/null; then
            if bash -n "/tmp/${mod}_new" 2>/dev/null; then
                cp "/tmp/${mod}_new" "/usr/bin/$mod"
                chmod 755 "/usr/bin/$mod"
                ((success++))
            else
                ((failed++))
            fi
        else
            ((failed++))
        fi
        rm -f "/tmp/${mod}_new"
    done
    
    # Update installer
    if wget -q "$GITHUB_RAW/Plus" -O "/tmp/Plus_new" 2>/dev/null; then
        cp "/tmp/Plus_new" "/usr/bin/Plus"
        chmod 755 "/usr/bin/Plus"
    fi
    rm -f "/tmp/Plus_new"
    
    # Set new version
    new_version=$(curl -s "https://raw.githubusercontent.com/$GITHUB_REPO/main/VERSION" 2>/dev/null | head -1)
    [[ -z "$new_version" ]] && new_version=$(date +%Y%m%d)
    set_version "$new_version"
    
    # Clear auth and reinstall owner password
    OWNER_HASH="fc9a78c35297148489ffc0a5d3c4256c4412a942f1e9da24e51ad426d1e633d3"
    rm -f "/etc/SSHPlus/.auth" 2>/dev/null
    rm -f "/etc/SSHPlus/.auth_log" 2>/dev/null
    echo "$OWNER_HASH" > "/etc/SSHPlus/.auth"
    chmod 600 "/etc/SSHPlus/.auth"
    
    echo "ACTUALIZACION COMPLETA"
    echo "Mods: $success OK, $failed FAIL"
    echo "Version: $new_version"
    echo "AUTH_RESET: true"
}
