#!/bin/bash
clear
rojo="\033[1;31m"
verde="\033[1;32m"
amarillo="\033[1;33m"
blanco="\033[1;37m"
fin="\033[0m"

echo -e "${rojo}═══════════════════════════════════════${fin}"
echo -e "${blanco}  GESTION DE LLAVES SSH - @Netxxus${fin}"
echo -e "${rojo}═══════════════════════════════════════${fin}"
echo ""

echo -e "${amarillo}  [1]${fin} Ver llaves autorizadas"
echo -e "${amarillo}  [2]${fin} Agregar llave publica"
echo -e "${amarillo}  [3]${fin} Eliminar llave publica"
echo -e "${amarillo}  [0]${fin} Volver"
echo ""
echo -ne "${blanco}  Opcion: ${fin}"; read op

case "$op" in
    1)
        clear
        echo -e "${blanco}  LLAVES PUBLICAS AUTORIZADAS:${fin}"
        echo -e "${rojo}─────────────────────────────────────────${fin}"
        if [[ -f /root/.ssh/authorized_keys ]]; then
            i=1
            while IFS= read -r line; do
                [[ -z "$line" ]] && continue
                key_type=$(echo "$line" | awk '{print $1}')
                key_data=$(echo "$line" | awk '{print $2}')
                key_short="${key_data:0:20}...${key_data: -10}"
                echo -e "  ${amarillo}[$i]${fin} $key_type $key_short"
                ((i++))
            done < /root/.ssh/authorized_keys
            echo ""
            echo -e "  Total: ${blanco}$(grep -c . /root/.ssh/authorized_keys)${fin} llaves"
        else
            echo -e "  ${rojo}No hay llaves autorizadas${fin}"
        fi
        ;;
    2)
        clear
        echo -e "${amarillo}  PEGUE LA LLAVE PUBLICA (ssh-rsa ...):${fin}"
        echo -ne "${blanco}  ${fin}"; read pubkey
        [[ -z "$pubkey" ]] && { echo -e "${rojo}Llave vacia!${fin}"; sleep 2; exit 1; }
        
        [[ ! -d /root/.ssh ]] && mkdir -p /root/.ssh && chmod 700 /root/.ssh
        echo "$pubkey" >> /root/.ssh/authorized_keys
        chmod 600 /root/.ssh/authorized_keys
        echo -e "${verde}  Llave agregada correctamente!${fin}"
        ;;
    3)
        clear
        if [[ ! -f /root/.ssh/authorized_keys ]]; then
            echo -e "${rojo}  No hay llaves autorizadas${fin}"
            sleep 2
            exit 0
        fi
        
        echo -e "${blanco}  LLAVES PUBLICAS:${fin}"
        i=1
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            key_type=$(echo "$line" | awk '{print $1}')
            key_data=$(echo "$line" | awk '{print $2}')
            key_short="${key_data:0:20}...${key_data: -10}"
            echo -e "  ${amarillo}[$i]${fin} $key_type $key_short"
            ((i++))
        done < /root/.ssh/authorized_keys
        
        echo ""
        echo -ne "${rojo}  Numero de llave a ELIMINAR (0=volver): ${fin}"; read num
        [[ "$num" == "0" ]] && exit 0
        
        total=$(grep -c . /root/.ssh/authorized_keys)
        if [[ "$num" -ge 1 && "$num" -le "$total" ]]; then
            sed -i "${num}d" /root/.ssh/authorized_keys
            echo -e "${verde}  Llave eliminada!${fin}"
        else
            echo -e "${rojo}  Numero invalido!${fin}"
        fi
        ;;
    0)
        exit 0
        ;;
    *)
        echo -e "${rojo}  Opcion invalida!${fin}"
        ;;
esac

echo ""
echo -e "${blanco}  [ENTER] Volver${fin}"
read
