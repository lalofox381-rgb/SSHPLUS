#!/bin/bash
clear

rojo="\033[1;31m"
gris="\033[1;37m"
amarillo="\033[1;33m"
verde="\033[1;32m"
fin="\033[0m"

fun_bar () {
comando[0]="$1"
comando[1]="$2"
(
[[ -e $HOME/fim ]] && rm $HOME/fim
${comando[0]} > /dev/null 2>&1
${comando[1]} > /dev/null 2>&1
touch $HOME/fim
) > /dev/null 2>&1 &
tput civis
echo -ne "  ${rojo}PROCESANDO ${gris}- ${rojo}["
while true; do
   for((i=0; i<18; i++)); do
   echo -ne "${rojo}#"
   sleep 0.1s
   done
   [[ -e $HOME/fim ]] && rm $HOME/fim && break
   echo -e "${rojo}]"
   sleep 1s
   tput cuu1
   tput dl1
   echo -ne "  ${rojo}PROCESANDO ${gris}- ${rojo}["
done
echo -e "${rojo}]${gris} -${verde} OK !${fin}"
tput cnorm
}

echo ""
echo -e "${rojo}═══════════════════════════════════════════════${fin}"
echo -e "${gris}    @BLACKBOSS_VPN SERVER MANAGER${fin}"
echo -e "${rojo}═══════════════════════════════════════════════${fin}"
echo ""

fun_atts () {
  [[ -e /home/versao ]] && rm /home/versao
  [[ -e /tmp/att ]] && rm /tmp/att
  wget -c -P /home https://raw.githubusercontent.com/BLACKBOSS/SSHPLUS/main/Install/versao > /dev/null 2>&1
  [[ -f "/home/versao" ]] && mv /home/versao /tmp/att
} > /dev/null 2>&1

echo -e "  ${rojo}VERIFICANDO ACTUALIZACIONES...${fin}"
echo ""
fun_bar 'fun_atts'
echo ""

[[ ! -f "/tmp/att" ]] && {
    echo -e "${rojo}  ERROR AL CONECTAR AL SERVIDOR${fin}"
    echo -ne "\n  ${rojo}ENTER ${gris}para volver al ${verde}MENU!${fin}"; read
    menu
}

vrs1=$(sed -n '1 p' /bin/versao 2>/dev/null | sed -e 's/[^0-9]//ig')
vrs2=$(sed -n '1 p' /tmp/att 2>/dev/null | sed -e 's/[^0-9]//ig')

[[ "$vrs1" == "$vrs2" ]] && {
    echo -e "${rojo}═══════════════════════════════════════════════${fin}"
    echo -e "${verde}  SCRIPT ACTUALIZADO - SIN NUEVAS ACTUALIZACIONES${fin}"
    echo -e "${rojo}═══════════════════════════════════════════════${fin}"
    echo ""
    echo -e "  ${gris}Version actual: ${amarillo}${vrs1}${fin}"
    echo -e "  ${gris}Telegram: ${rojo}@BLACKBOSS_VPN${fin}"
    rm /tmp/att > /dev/null 2>&1
    echo -ne "\n  ${rojo}ENTER ${gris}para volver al ${verde}MENU!${fin}"; read
    menu
} || {
    echo -e "${rojo}═══════════════════════════════════════════════${fin}"
    echo -e "${amarillo}  NUEVA ACTUALIZACION DISPONIBLE${fin}"
    echo -e "${rojo}═══════════════════════════════════════════════${fin}"
    echo ""
    echo -e "  ${gris}Version actual: ${rojo}${vrs1}${fin}"
    echo -e "  ${gris}Nueva version:  ${verde}${vrs2}${fin}"
    echo ""
    echo -e "${rojo}───────────────────────────────────────────────${fin}"
    echo -e "${gris}  CAMBIOS:${fin}"
    echo -e "${rojo}───────────────────────────────────────────────${fin}"
    while read linha; do
        echo -e "  ${gris}• ${amarillo}${linha}${fin}"
    done < "/tmp/att"
    echo -e "${rojo}───────────────────────────────────────────────${fin}"
    echo ""
    echo -e "  ${gris}Telegram: ${rojo}@BLACKBOSS_VPN${fin}"
    echo ""
    echo -ne "  ${amarillo}DESEA ACTUALIZAR? [s/n]: ${fin}"; read res

    if [[ "$res" = @(s|S) ]]; then
        echo ""
        echo -e "${rojo}  INICIANDO ACTUALIZACION...${fin}"
        echo ""
        sleep 2
        wget -O /tmp/Plus_new https://raw.githubusercontent.com/BLACKBOSS/SSHPLUS/main/Plus > /dev/null 2>&1
        if [[ -f /tmp/Plus_new ]]; then
            chmod +x /tmp/Plus_new
            /tmp/Plus_new
            rm -f /tmp/Plus_new
            rm /tmp/att > /dev/null 2>&1
            echo ""
            echo -e "${rojo}═══════════════════════════════════════════════${fin}"
            echo -e "${verde}  ACTUALIZACION COMPLETADA${fin}"
            echo -e "${rojo}═══════════════════════════════════════════════${fin}"
        else
            echo -e "\n${rojo}  ERROR AL DESCARGAR ACTUALIZACION${fin}"
        fi
        echo -ne "\n  ${rojo}ENTER ${gris}para volver al ${verde}MENU!${fin}"; read
        menu
    else
        rm /tmp/att > /dev/null 2>&1
        menu
    fi
}
