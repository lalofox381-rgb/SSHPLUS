#!/bin/bash
clear
rojo="\033[1;31m"
verde="\033[1;32m"
amarillo="\033[1;33m"
blanco="\033[1;37m"
fin="\033[0m"
database="/root/usuarios.db"

echo -e "${rojo}═══════════════════════════════════════${fin}"
echo -e "${blanco}  USUARIOS EN MASA - @Netxxus${fin}"
echo -e "${rojo}═══════════════════════════════════════${fin}"
echo ""

echo -e "${amarillo}  PREFIJO DE USUARIO:${fin} "; read prefijo
[[ -z "$prefijo" ]] && { echo -e "${rojo}Prefijo vacio!${fin}"; sleep 2; exit 1; }

echo -e "${amarillo}  CANTIDAD A CREAR:${fin} "; read cantidad
[[ -z "$cantidad" || "$cantidad" -lt 1 ]] && { echo -e "${rojo}Cantidad invalida!${fin}"; sleep 2; exit 1; }

echo -e "${amarillo}  DIAS DE EXPIRACION:${fin} "; read dias
dias=${dias:-30}

echo -e "${amarillo}  LIMITE DE CONEXIONES:${fin} "; read limite
limite=${limite:-1}

echo -e "${amarillo}  CONTRASENA PARA TODOS:${fin} "; read passbase
[[ -z "$passbase" ]] && { echo -e "${rojo}Contrasena vacia!${fin}"; sleep 2; exit 1; }

echo ""
echo -e "${amarillo}  RESUMEN:${fin}"
echo -e "  Prefijo: ${blanco}$prefijo${fin}"
echo -e "  Cantidad: ${blanco}$cantidad${fin}"
echo -e "  Expira en: ${blanco}$dias dias${fin}"
echo -e "  Limite: ${blanco}$limite conexiones${fin}"
echo ""
echo -ne "${rojo}  CONFIRMAR? [s/n]: ${fin}"; read conf
[[ "$conf" != "s" && "$conf" != "S" ]] && { echo -e "${rojo}Cancelado.${fin}"; exit 0; }

echo ""
creados=0
fallidos=0

for ((i=1; i<=cantidad; i++)); do
    user="${prefijo}$(printf '%03d' $i)"
    pass="${passbase}${i}"
    
    # Verificar si ya existe
    if id "$user" &>/dev/null; then
        echo -e "  ${rojo}✗${fin} $user ya existe"
        ((fallidos++))
        continue
    fi
    
    # Calcular fecha de expiracion
    total_min=$((dias * 1440))
    final_date=$(date "+%Y-%m-%d" -d "+$total_min minutes")
    pass_hash=$(openssl passwd -6 "$pass" 2>/dev/null || mkpasswd -m sha-512 "$pass" 2>/dev/null)
    
    # Crear usuario
    useradd -e "$final_date" -M -s /bin/false -p "$pass_hash" "$user" 2>/dev/null
    if [[ $? -eq 0 ]]; then
        echo "$pass" > "/etc/SSHPlus/senha/$user"
        echo "$user $limite" >> "$database"
        echo -e "  ${verde}✓${fin} $user - Pass: $pass - Expira: $(date '+%d/%m/%Y' -d "+$total_min minutes")"
        ((creados++))
    else
        echo -e "  ${rojo}✗${fin} Error creando $user"
        ((fallidos++))
    fi
done

echo ""
echo -e "${rojo}─────────────────────────────────────────${fin}"
echo -e "${verde}  CREADOS: $creados${fin}  ${rojo}FALLIDOS: $fallidos${fin}"
echo -e "${rojo}─────────────────────────────────────────${fin}"
echo ""
echo -e "${blanco}  [ENTER] Volver${fin}"
read
